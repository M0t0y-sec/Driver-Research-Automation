# ============================================================
# DRA — .gitignore
# Runtime data, build outputs, secrets — nothing here goes to GitHub.
# ============================================================

# --- Runtime / state ---
artifacts/
/artifacts/
data/
/data/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
**/node_modules/
web/dist/
.vite/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Claude Code local config (do not commit personal perms / hooks)
.claude/settings.local.json

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Driver binaries (never commit)
*.sys
*.drv
*.dll
*.bin

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# LangGraph / checkpoints
checkpoints/
.lgraph/

# Coverage
coverage/
.nyc_output/

# OS metadata
desktop.ini
$RECYCLE.BIN/

# Local test artifacts
tmp/
.tmp/

# Unrelated third-party installer docs dropped in the workspace
install.md
install.ps1
install_ef.ps1