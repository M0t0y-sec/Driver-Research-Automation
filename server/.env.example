# DRA Server environment
# All paths default to ../artifacts/ relative to the server/ directory.
# Override here when running on other machines.

DRA_DATA_DIR=../artifacts/data
DRA_ARTIFACTS_DIR=../artifacts/artefacts
DRA_LOG_LEVEL=INFO
DRA_AUTH_MODE=local          # local | oidc (Phase 2+)
DRA_LLM_PROVIDER=mock        # mock | anthropic (default: mock; no key needed)
DRA_LAB_PROVIDER=mock        # mock | hyperv | vmware | libvirt

# --- Real model provider (DRA_LLM_PROVIDER=anthropic) ---
# Preferred key variable; falls back to ANTHROPIC_API_KEY.
# NEVER commit a real key.
DRA_ANTHROPIC_API_KEY=

# Per-tier model ids. The router assigns every task a tier
# (small/mid/large); each tier maps to one model here. Models must
# support structured outputs (output_config.format).
DRA_ANTHROPIC_MODEL_SMALL=claude-haiku-5-5
DRA_ANTHROPIC_MODEL_MID=claude-sonnet-5-5
DRA_ANTHROPIC_MODEL_LARGE=claude-opus-5-5

DRA_ANTHROPIC_MAX_TOKENS=16000
DRA_ANTHROPIC_TIMEOUT=300
DRA_ANTHROPIC_MAX_RETRIES=2

# Optional legacy escape hatch. The SDK's default API version (2026-10-21)
# rejects temperature/top_p/top_k. The router's per-task temperatures are
# still recorded on LLMResponse; they are only transmitted to the API when
# an older version is pinned here.
# DRA_ANTHROPIC_API_VERSION=2023-06-01
