# DRA Server environment
# All paths default to ../artifacts/ relative to the server/ directory.
# Override here when running on other machines.

DRA_DATA_DIR=../artifacts/data
DRA_ARTIFACTS_DIR=../artifacts/artefacts
DRA_LOG_LEVEL=INFO
DRA_AUTH_MODE=local          # local | oidc (Phase 2+)
DRA_LLM_PROVIDER=mock         # mock | openai | anthropic | custom
DRA_LAB_PROVIDER=mock         # mock | hyperv | vmware | libvirt
